{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://carfinder-project-backend.onrender.com https://accounts.google.com; frame-src https://accounts.google.com; frame-ancestors 'none';" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://carfinder-project-backend.onrender.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://carfinder-project-backend.onrender.com/api/:path*"
    },
    {
      "source": "/user/:path*",
      "destination": "https://carfinder-project-backend.onrender.com/user/:path*"
    },
    {
      "source": "/draco/:file*",
      "destination": "/draco/:file*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}