{
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "Strict-Transport-Security",
                                            "value":  "max-age=63072000; includeSubDomains; preload"
                                        },
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027wasm-unsafe-eval\u0027 https://accounts.google.com https://www.gstatic.com; style-src \u0027self\u0027 \u0027unsafe-inline\u0027 https://fonts.googleapis.com; font-src \u0027self\u0027 https://fonts.gstatic.com data:; img-src \u0027self\u0027 data: blob: https:; connect-src \u0027self\u0027 blob: https://carfinder-project-backend.onrender.com https://accounts.google.com https://raw.githubusercontent.com https://www.gstatic.com https://api.web3forms.com; frame-src https://accounts.google.com; frame-ancestors \u0027none\u0027; worker-src blob:;"
                                        },
                                        {
                                            "key":  "Server",
                                            "value":  ""
                                        }
                                    ]
                    },
                    {
                        "source":  "/assets/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    }
                ],
    "rewrites":  [
                     {
                         "source":  "/auth/:path*",
                         "destination":  "https://carfinder-project-backend.onrender.com/auth/:path*"
                     },
                     {
                         "source":  "/api/:path*",
                         "destination":  "https://carfinder-project-backend.onrender.com/api/:path*"
                     },
                     {
                         "source":  "/user/:path*",
                         "destination":  "https://carfinder-project-backend.onrender.com/user/:path*"
                     },
                     {
                         "source":  "/draco/:file*",
                         "destination":  "/draco/:file*"
                     },
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ]
}
