{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://carfinder-project-backend.onrender.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://carfinder-project-backend.onrender.com/api/:path*"
    },
    {
      "source": "/user/:path*",
      "destination": "https://carfinder-project-backend.onrender.com/user/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}