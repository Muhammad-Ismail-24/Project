─────────────────────────────────────────────
GOOGLE OAUTH (get from console.cloud.google.com)
─────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

─────────────────────────────────────────────
GEMINI API (get from aistudio.google.com)
─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

─────────────────────────────────────────────
GROQ API (get from console.groq.com)
─────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here

─────────────────────────────────────────────
OPENROUTER (deprecated, but keeping for compatibility)
─────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here

─────────────────────────────────────────────
DATABASE
─────────────────────────────────────────────
DATABASE_URL=sqlite:///./drivefetch.db

─────────────────────────────────────────────
SERVER CONFIGURATION
─────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

─────────────────────────────────────────────
FRONTEND URL (for CORS)
─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

─────────────────────────────────────────────
SESSION SECURITY (generate with: python -c "import secrets; print(secrets.token_hex(32))")
─────────────────────────────────────────────
SECRET_KEY=generate-a-random-64-char-hex-string
SESSION_SECRET_KEY=generate-a-random-64-char-hex-string
