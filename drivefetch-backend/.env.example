# The full URL of the deployed frontend, e.g. https://drivefetch.vercel.app
FRONTEND_URL=https://drivefetch.vercel.app

# API Keys for AI Models
openrouter_api_key=
groq_api_key=your-groq-api-key-here
gemini_api_key=
google_api_key=

# Database configuration
database_url=sqlite:///./drivefetch.db

# Server configuration
port=8000
host=0.0.0.0

# Security and session keys
secret_key=super-secret-key-for-local-dev
SESSION_SECRET_KEY=change-this-in-production

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini model pool configuration (comma-separated list of models)
gemini_model_pool=

